{
  "name": "urban-tanker-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n FE,BE -c blue,green \"npm run dev\" \"npm run dev --prefix backend\"",
    "start": "npm run start --prefix backend",
    "db:check": "npm run db:check --prefix backend",
    "build:hostinger": "npm run build && npm run build --prefix backend",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:booking": "playwright test --config=playwright.booking.config.ts",
    "reference": "node scripts/serve-reference.mjs",
    "reference:list": "node scripts/serve-reference.mjs --list"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "^5.90.16",
    "core-js": "^3.51.0",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.55.0",
    "react-leaflet": "^5.0.0",
    "sass": "^1.86.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
