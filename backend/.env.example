NODE_ENV=development
PORT=8080
# Logging: error | warn | success | info | debug. Development prints colored lines to the console.
LOG_LEVEL=info
# Must be an https:// origin when NODE_ENV=production.
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# One of SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY is required.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Required in production when SUPABASE_DB_URL is set. Paste the Supabase CA certificate (PEM); use \n for line breaks.
DB_SSL_CA=
DB_POOL_MAX=10
# Set when running more than one API instance (shared realtime and rate limits). Leave blank for a single instance.
REDIS_URL=
ADMIN_REGISTRATION_KEY=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional; when blank, the SMTP_USER Gmail address is used as the sender.
MAIL_FROM=
# SMS provider: msg91 (default) or twilio. Switch back by setting SMS_PROVIDER=twilio.
SMS_PROVIDER=msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 SMS (used when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_USER_REGISTRATION_OTP=
MSG91_TEMPLATE_ID_BOOKING_VERIFICATION_OTP=
MSG91_TEMPLATE_ID_GUEST_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_ID_VENDOR_ACCEPTANCE=
MSG91_TEMPLATE_ID_DELIVERY_CONFIRMATION=
MSG91_TEMPLATE_ID_DELIVERY_OTP=
MSG91_TEMPLATE_ID_COD_SWITCHED_TO_ONLINE=
MSG91_TEMPLATE_ID_COD_REVERTED_TO_CASH=
# Set to false to stop customers from switching a cash booking to online payment.
COD_ONLINE_SWITCH_ENABLED=true
# Fallback booking verification for when SMS is unavailable. Must stay false in production (the server refuses to start otherwise).
USE_DEFAULT_VERIFICATION_CODE=false
DEFAULT_VERIFICATION_CODE=123456
REQUIRE_BOOKING_PHONE_VERIFICATION=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ANONYMIZE_AFTER_DAYS=7
# Required in production (32+ characters). Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=
# Optional. GST percentage applied to quotes (web and mobile read it from /api/customer/pricing). Defaults to 18 when unset.
APPLIED_GST_PERCENTAGE=
# Optional test mode. When true, every service line is quoted and charged ₹1 with 0% GST, the web estimate shows ₹1 per service, and coupons are ignored. Never enable in production (the server refuses to start).
TEST_PRICING_ENABLED=
