NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DB_POOL_MAX=10
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional; when blank, the SMTP_USER Gmail address is used as the sender.
MAIL_FROM=
# SMS provider: msg91 (default) or twilio. Switch back by setting SMS_PROVIDER=twilio.
SMS_PROVIDER=msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 SMS (used when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_USER_REGISTRATION_OTP=
MSG91_TEMPLATE_ID_BOOKING_VERIFICATION_OTP=
MSG91_TEMPLATE_ID_GUEST_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_ID_VENDOR_ACCEPTANCE=
MSG91_TEMPLATE_ID_DELIVERY_CONFIRMATION=
MSG91_TEMPLATE_ID_DELIVERY_OTP=
# Set true while SMS is unavailable to use DEFAULT_VERIFICATION_CODE for booking verification.
USE_DEFAULT_VERIFICATION_CODE=
DEFAULT_VERIFICATION_CODE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ANONYMIZE_AFTER_DAYS=7
WHATSAPP_FROM_NUMBER=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
