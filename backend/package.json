{
  "name": "urban-tanker-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:check": "tsx src/scripts/db-check.ts",
    "db:update": "tsx src/scripts/apply-database-update.ts",
    "db:backup": "tsx src/scripts/backup-postgres.ts",
    "db:reset": "tsx src/scripts/reset-database.ts",
    "dev": "npm run db:check && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run db:check && node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.6",
    "pg": "^8.13.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  }
}
