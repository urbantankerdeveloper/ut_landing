# Copy to .env.local (gitignored) and fill in. Vite inlines VITE_* values into the public bundle.
# Restrict the Maps JavaScript API key to your HTTP referrers (see docs/google_maps_setup.md).
VITE_GOOGLE_MAPS_API_KEY=
# Set to true to show booking CTAs to public visitors, customers, and admins. Defaults to false.
VITE_SHOW_BOOKING_BUTTON=false
# Set to true to prompt signed-in users to verify their phone. Defaults to false.
VITE_PHONE_VERIFY_DIALOG_ENABLED=false
