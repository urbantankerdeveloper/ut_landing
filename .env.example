# Copy to .env.local (gitignored) and fill in. Vite inlines VITE_* values into the public bundle.
# Google Maps is primary when configured; Leaflet/OpenStreetMap is the fallback.
# Restrict this public Maps JavaScript API key to your HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=
# Set to true to show booking CTAs to public visitors, customers, and admins. Defaults to false.
VITE_SHOW_BOOKING_BUTTON=false
# Set to true to prompt signed-in users to verify their phone. Defaults to false.
VITE_PHONE_VERIFY_DIALOG_ENABLED=false
# Set to true to show the My Profile item in the customer workspace menu. The name badge remains available.
VITE_PROFILE_MENU_ENABLED=false
# Set to true to use the multi-service parent-order experience. Defaults to false.
VITE_MULTI_SERVICE_ORDERS_ENABLED=false
VITE_ADMIN_EXPORT_LIGHT=false
VITE_ANALYTICS_BATCH=false
VITE_SOCKET_DRIVEN_REFRESH=false
VITE_SOCKET_DYNAMIC_LOADING=false
VITE_SITE_ORIGIN=https://www.urbantanker.in
VITE_LANDING_SCROLL_ANIMATIONS=true
VITE_LANDING_3D_EFFECTS=true
# Set to true to use the refreshed service page with photos and motion. Defaults to the original UI.
VITE_SERVICE_BACKGROUNDS=false
VITE_HOME_WEBGL_HERO=false
PEXELS_API_KEY=
PIXABAY_API_KEY=
