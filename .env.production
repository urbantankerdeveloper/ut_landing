# Hostinger serves this frontend (public_html); the API runs on Render, so both URLs point at the Render origin.
# The Content-Security-Policy in public/.htaccess must list the same origin in connect-src.
VITE_API_BASE_URL=https://urban-tanker-backend.onrender.com/api
VITE_REALTIME_URL=https://urban-tanker-backend.onrender.com
# Supabase project ref (public, not a secret); used by scripts/prepare-deploy-config.mjs to fill the CSP.
SUPABASE_REF=qlotsoputalbqkbkezlt
